<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XUẤT KHO PHI THƯƠNG MẠI (MOD-03-03)"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Gửi bảo hành hãng hoặc tiêu hủy đồng hồ lỗi kỹ thuật khỏi kho chứa."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Chọn Serial Đồng Hồ (Kho Lỗi / Trưng Bày / Tồn Kho)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spOtherSerial"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@color/bg_light"
            android:paddingHorizontal="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mục Đích Xuất Khác"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spOtherPurpose"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@color/bg_light"
            android:paddingHorizontal="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Lý Do / Biên Bản Giám Định"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etOtherReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/bg_light"
            android:hint="VD: Gửi Hãng Thụy Sĩ bảo dưỡng máy / Tiêu hủy linh kiện hỏng"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvOtherDispatchWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/badge_low_bg"
            android:padding="10dp"
            android:text="Lưu ý phân quyền: Tác vụ Tiêu hủy vĩnh viễn (TIEU_HUY) yêu cầu tài khoản ADMIN hoặc WAREHOUSE_MANAGER."
            android:textColor="@color/badge_low_text"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelOtherDispatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/bg_light"
                android:text="Hủy"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnConfirmOtherDispatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary"
                android:text="Xác Nhận Xuất Khác"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

