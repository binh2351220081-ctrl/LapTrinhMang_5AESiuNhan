<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Order Code & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DS-2026-001"
                android:textColor="@color/accent_gold_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="#FEF3C7"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="🔒 Đã Giữ Chỗ (Reserved)"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dealer Name & Date -->
        <TextView
            android:id="@+id/tvOrderDealerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🏪 Galle Watch Việt Nam"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderCreatedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Ngày đặt: 10/11/2026 14:10"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Product Line Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F8FAFC"
            android:padding="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderProductSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⌚ Rolex Submariner Date 41mm"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderQuantitySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quy cách: 2 chiếc lẻ (Chiết khấu 30%)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Financial Breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng tiền sau CK:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOrderTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="448.000.000 đ"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderDeposit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đã cọc: 150.000.000 đ"
                android:textColor="#059669"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvOrderRemainingDebt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn nợ: 298.000.000 đ"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDispatchOrder"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📦 Quét Serial Xuất Kho"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                app:backgroundTint="@color/accent_gold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

